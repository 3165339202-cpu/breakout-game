{
 "version": "2.0.0",
 "tasks": [
  {
   "label": "build cpp",
   "type": "shell",
   "command": "g++",
   "args": [
    "-g",
    "${file}",
    "-o",
    "${fileDirname}/${fileBasenameNoExtension}",
    "-lraylib",
    "-lGL",
    "-lm",
    "-lpthread",
    "-ldl",
    "-lrt",
    "-lX11"
   ],
   "group": {
    "kind": "build",
    "isDefault": true
   }
  }
 ]
}